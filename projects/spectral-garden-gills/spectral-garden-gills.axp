<patch-1.0 appVersion="1.0.12">
   <comment type="patch/comment" x="14" y="14" text="SPECTRAL GARDEN - six-band scale resonator for Ksoloti Gills"/>
   <comment type="patch/comment" x="14" y="42" text="Pots: 1-6 interacting band energy | 7 rotate | 8 spread | 9 resonance | 10 motion"/>
   <comment type="patch/comment" x="14" y="70" text="Buttons: 1 source | 2 mutate | 3 hold | 4 scale | Encoder root | push strike"/>

   <obj type="audio/inconfig" uuid="9a80ef3c19f2a8f81da3a3b7c1c44d18126b97d9" name="input_config" x="14" y="112">
      <params/>
      <attribs>
         <combo attributeName="gain" selection="0dB"/>
         <combo attributeName="boost" selection="0dB"/>
         <combo attributeName="mode" selection="Stereo"/>
      </attribs>
   </obj>

   <obj type="audio/outconfig" uuid="eace67e3304afaa1bb695b444e9345f2d8adaf00" name="output_config" x="154" y="112">
      <params/>
      <attribs>
         <combo attributeName="headphones" selection="-24dB"/>
         <combo attributeName="mode" selection="Stereo"/>
      </attribs>
   </obj>

   <obj type="const/i" uuid="e202f44b2df17ae0b3e663b98ea6b14c8ff00408" name="root_init" x="294" y="112">
      <params/>
      <attribs><spinner attributeName="value" value="36"/></attribs>
   </obj>

   <obj type="ksoloti/gills/encoder" uuid="8d8c7129-cce1-491f-98b4-6ecb6355cfee" name="root" x="406" y="98">
      <params/>
      <attribs>
         <spinner attributeName="min" value="24"/>
         <spinner attributeName="max" value="60"/>
      </attribs>
   </obj>

   <obj type="audio/in stereo" uuid="99848ad6d90a8e615e83b2e619cfc806f28e7281" name="audio_in" x="14" y="196">
      <params/>
      <attribs/>
   </obj>

   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="band1" x="14" y="280">
      <params/><attribs><combo attributeName="pot" selection="1"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="band2" x="14" y="336">
      <params/><attribs><combo attributeName="pot" selection="2"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="band3" x="14" y="392">
      <params/><attribs><combo attributeName="pot" selection="3"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="band4" x="14" y="448">
      <params/><attribs><combo attributeName="pot" selection="4"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="band5" x="14" y="504">
      <params/><attribs><combo attributeName="pot" selection="5"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="band6" x="14" y="560">
      <params/><attribs><combo attributeName="pot" selection="6"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="rotate" x="14" y="616">
      <params/><attribs><combo attributeName="pot" selection="7"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="spread" x="14" y="672">
      <params/><attribs><combo attributeName="pot" selection="8"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="resonance" x="14" y="728">
      <params/><attribs><combo attributeName="pot" selection="9"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="motion" x="14" y="784">
      <params/><attribs><combo attributeName="pot" selection="10"/></attribs>
   </obj>

   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="source" x="182" y="280">
      <params/><attribs><combo attributeName="button" selection="1"/></attribs>
   </obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="mutate" x="182" y="350">
      <params/><attribs><combo attributeName="button" selection="2"/></attribs>
   </obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="hold" x="182" y="420">
      <params/><attribs><combo attributeName="button" selection="3"/></attribs>
   </obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="scale" x="182" y="490">
      <params/><attribs><combo attributeName="button" selection="4"/></attribs>
   </obj>

   <obj type="./spectralgarden" uuid="3E167A80-2972-4F58-9D77-BF7EC9A2D1C6" name="spectralgarden" x="392" y="266">
      <params/>
      <attribs/>
   </obj>

   <obj type="audio/out stereo" uuid="a1ca7a567f535acc21055669829101d3ee7f0189" name="audio_out" x="756" y="280">
      <params/><attribs/>
   </obj>

   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led1" x="756" y="392">
      <params/><attribs><combo attributeName="led" selection="1"/></attribs>
   </obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led2" x="756" y="448">
      <params/><attribs><combo attributeName="led" selection="2"/></attribs>
   </obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led3" x="756" y="504">
      <params/><attribs><combo attributeName="led" selection="3 blue"/></attribs>
   </obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led4" x="756" y="560">
      <params/><attribs><combo attributeName="led" selection="4 blue"/></attribs>
   </obj>

   <obj type="ksoloti/gills/display" uuid="0c083e83-0280-4cf2-b747-8a00859bb904" name="display" x="756" y="658">
      <params/>
      <attribs>
         <combo attributeName="useScope" selection="off"/>
         <objref attributeName="scope" obj=""/>
         <combo attributeName="narrowFont" selection="on"/>
      </attribs>
   </obj>

   <nets>
      <net><source obj="root_init" outlet="out"/><dest obj="root" inlet="set"/></net>
      <net><source obj="root" outlet="out"/><dest obj="spectralgarden" inlet="root"/></net>
      <net><source obj="root" outlet="sw"/><dest obj="spectralgarden" inlet="strike"/></net>

      <net><source obj="audio_in" outlet="left"/><dest obj="spectralgarden" inlet="left"/></net>
      <net><source obj="audio_in" outlet="right"/><dest obj="spectralgarden" inlet="right"/></net>

      <net><source obj="band1" outlet="out"/><dest obj="spectralgarden" inlet="band1"/></net>
      <net><source obj="band2" outlet="out"/><dest obj="spectralgarden" inlet="band2"/></net>
      <net><source obj="band3" outlet="out"/><dest obj="spectralgarden" inlet="band3"/></net>
      <net><source obj="band4" outlet="out"/><dest obj="spectralgarden" inlet="band4"/></net>
      <net><source obj="band5" outlet="out"/><dest obj="spectralgarden" inlet="band5"/></net>
      <net><source obj="band6" outlet="out"/><dest obj="spectralgarden" inlet="band6"/></net>
      <net><source obj="rotate" outlet="out"/><dest obj="spectralgarden" inlet="rotate"/></net>
      <net><source obj="spread" outlet="out"/><dest obj="spectralgarden" inlet="spread"/></net>
      <net><source obj="resonance" outlet="out"/><dest obj="spectralgarden" inlet="resonance"/></net>
      <net><source obj="motion" outlet="out"/><dest obj="spectralgarden" inlet="motion"/></net>

      <net><source obj="source" outlet="out"/><dest obj="spectralgarden" inlet="source"/></net>
      <net><source obj="mutate" outlet="out"/><dest obj="spectralgarden" inlet="mutate"/></net>
      <net><source obj="hold" outlet="out"/><dest obj="spectralgarden" inlet="hold"/></net>
      <net><source obj="scale" outlet="out"/><dest obj="spectralgarden" inlet="scale"/></net>

      <net><source obj="spectralgarden" outlet="left"/><dest obj="audio_out" inlet="left"/></net>
      <net><source obj="spectralgarden" outlet="right"/><dest obj="audio_out" inlet="right"/></net>
      <net><source obj="spectralgarden" outlet="led1"/><dest obj="led1" inlet="in"/></net>
      <net><source obj="spectralgarden" outlet="led2"/><dest obj="led2" inlet="in"/></net>
      <net><source obj="spectralgarden" outlet="led3"/><dest obj="led3" inlet="in"/></net>
      <net><source obj="spectralgarden" outlet="led4"/><dest obj="led4" inlet="in"/></net>
      <net><source obj="spectralgarden" outlet="line1"/><dest obj="display" inlet="line1"/></net>
      <net><source obj="spectralgarden" outlet="line2"/><dest obj="display" inlet="line2"/></net>
      <net><source obj="spectralgarden" outlet="line3"/><dest obj="display" inlet="line3"/></net>
      <net><source obj="spectralgarden" outlet="line4"/><dest obj="display" inlet="line4"/></net>
   </nets>

   <settings>
      <subpatchmode>no</subpatchmode>
      <MidiChannel>1</MidiChannel>
      <NPresets>0</NPresets>
      <NPresetEntries>0</NPresetEntries>
      <NModulationSources>0</NModulationSources>
      <NModulationTargetsPerSource>0</NModulationTargetsPerSource>
      <Author>Lance Ship</Author>
   </settings>
   <notes><![CDATA[Spectral Garden starts in self-excited PULSE mode. Pots 1-6 set interacting band energy: moving one can excite and bend its neighbors. Pot 9 controls ringing and Pot 10 controls generative rate, glide, and interaction depth. Button 1 reaches AIR and INPUT modes; encoder push manually strikes the current chord.]]></notes>
   <windowPos><x>100</x><y>60</y><width>980</width><height>900</height></windowPos>
</patch-1.0>
