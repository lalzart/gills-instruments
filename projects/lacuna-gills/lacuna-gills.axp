<patch-1.0 appVersion="1.0.12">
   <comment type="patch/comment" x="14" y="14" text="LACUNA - continuous field played by removing sound"/>
   <comment type="patch/comment" x="14" y="42" text="Top: pitch | spread | density | air | motion"/>
   <comment type="patch/comment" x="14" y="70" text="Bottom: gap | edge | depth | mutation | scar"/>
   <comment type="patch/comment" x="14" y="98" text="Buttons: BODY | FORM | AIR | VOID | Encoder tempo | tap capture | hold clear"/>

   <obj type="audio/outconfig" uuid="eace67e3304afaa1bb695b444e9345f2d8adaf00" name="output_config" x="14" y="140">
      <params/><attribs><combo attributeName="headphones" selection="-24dB"/><combo attributeName="mode" selection="Stereo"/></attribs>
   </obj>
   <obj type="const/i" uuid="e202f44b2df17ae0b3e663b98ea6b14c8ff00408" name="tempo_init" x="154" y="140"><params/><attribs><spinner attributeName="value" value="96"/></attribs></obj>
   <obj type="ksoloti/gills/encoder" uuid="8d8c7129-cce1-491f-98b4-6ecb6355cfee" name="tempo" x="266" y="126"><params/><attribs><spinner attributeName="min" value="40"/><spinner attributeName="max" value="180"/></attribs></obj>

   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="pitch" x="14" y="238"><params/><attribs><combo attributeName="pot" selection="1"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="spread" x="14" y="294"><params/><attribs><combo attributeName="pot" selection="2"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="density" x="14" y="350"><params/><attribs><combo attributeName="pot" selection="3"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="air" x="14" y="406"><params/><attribs><combo attributeName="pot" selection="4"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="motion" x="14" y="462"><params/><attribs><combo attributeName="pot" selection="5"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="gap" x="14" y="518"><params/><attribs><combo attributeName="pot" selection="6"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="edge" x="14" y="574"><params/><attribs><combo attributeName="pot" selection="7"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="depth" x="14" y="630"><params/><attribs><combo attributeName="pot" selection="8"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="mutation" x="14" y="686"><params/><attribs><combo attributeName="pot" selection="9"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="scar" x="14" y="742"><params/><attribs><combo attributeName="pot" selection="10"/></attribs></obj>

   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="body" x="182" y="238"><params/><attribs><combo attributeName="button" selection="1"/></attribs></obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="form" x="182" y="308"><params/><attribs><combo attributeName="button" selection="2"/></attribs></obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="airgap" x="182" y="378"><params/><attribs><combo attributeName="button" selection="3"/></attribs></obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="voidgap" x="182" y="448"><params/><attribs><combo attributeName="button" selection="4"/></attribs></obj>

   <obj type="./lacuna" uuid="904FA595-C2E9-45F9-BF08-2E6F07CFB77A" name="lacuna" x="406" y="252"><params/><attribs/></obj>
   <obj type="audio/out stereo" uuid="a1ca7a567f535acc21055669829101d3ee7f0189" name="audio_out" x="770" y="266"><params/><attribs/></obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led1" x="770" y="378"><params/><attribs><combo attributeName="led" selection="1"/></attribs></obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led2" x="770" y="434"><params/><attribs><combo attributeName="led" selection="2"/></attribs></obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led3" x="770" y="490"><params/><attribs><combo attributeName="led" selection="3 blue"/></attribs></obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led4" x="770" y="546"><params/><attribs><combo attributeName="led" selection="4 blue"/></attribs></obj>
   <obj type="ksoloti/gills/display" uuid="0c083e83-0280-4cf2-b747-8a00859bb904" name="display" x="770" y="644"><params/><attribs><combo attributeName="useScope" selection="off"/><objref attributeName="scope" obj=""/><combo attributeName="narrowFont" selection="on"/></attribs></obj>

   <nets>
      <net><source obj="tempo_init" outlet="out"/><dest obj="tempo" inlet="set"/></net>
      <net><source obj="tempo" outlet="out"/><dest obj="lacuna" inlet="tempo"/></net>
      <net><source obj="tempo" outlet="sw"/><dest obj="lacuna" inlet="capture"/></net>
      <net><source obj="pitch" outlet="out"/><dest obj="lacuna" inlet="pitch"/></net>
      <net><source obj="spread" outlet="out"/><dest obj="lacuna" inlet="spread"/></net>
      <net><source obj="density" outlet="out"/><dest obj="lacuna" inlet="density"/></net>
      <net><source obj="air" outlet="out"/><dest obj="lacuna" inlet="air"/></net>
      <net><source obj="motion" outlet="out"/><dest obj="lacuna" inlet="motion"/></net>
      <net><source obj="gap" outlet="out"/><dest obj="lacuna" inlet="gap"/></net>
      <net><source obj="edge" outlet="out"/><dest obj="lacuna" inlet="edge"/></net>
      <net><source obj="depth" outlet="out"/><dest obj="lacuna" inlet="depth"/></net>
      <net><source obj="mutation" outlet="out"/><dest obj="lacuna" inlet="mutation"/></net>
      <net><source obj="scar" outlet="out"/><dest obj="lacuna" inlet="scar"/></net>
      <net><source obj="body" outlet="out"/><dest obj="lacuna" inlet="body"/></net>
      <net><source obj="form" outlet="out"/><dest obj="lacuna" inlet="form"/></net>
      <net><source obj="airgap" outlet="out"/><dest obj="lacuna" inlet="airgap"/></net>
      <net><source obj="voidgap" outlet="out"/><dest obj="lacuna" inlet="voidgap"/></net>
      <net><source obj="lacuna" outlet="left"/><dest obj="audio_out" inlet="left"/></net>
      <net><source obj="lacuna" outlet="right"/><dest obj="audio_out" inlet="right"/></net>
      <net><source obj="lacuna" outlet="led1"/><dest obj="led1" inlet="in"/></net>
      <net><source obj="lacuna" outlet="led2"/><dest obj="led2" inlet="in"/></net>
      <net><source obj="lacuna" outlet="led3"/><dest obj="led3" inlet="in"/></net>
      <net><source obj="lacuna" outlet="led4"/><dest obj="led4" inlet="in"/></net>
      <net><source obj="lacuna" outlet="line1"/><dest obj="display" inlet="line1"/></net>
      <net><source obj="lacuna" outlet="line2"/><dest obj="display" inlet="line2"/></net>
      <net><source obj="lacuna" outlet="line3"/><dest obj="display" inlet="line3"/></net>
      <net><source obj="lacuna" outlet="line4"/><dest obj="display" inlet="line4"/></net>
   </nets>

   <settings><subpatchmode>no</subpatchmode><MidiChannel>1</MidiChannel><NPresets>0</NPresets><NPresetEntries>0</NPresetEntries><NModulationSources>0</NModulationSources><NModulationTargetsPerSource>0</NModulationTargetsPerSource><Author>Lance Ship</Author></settings>
   <notes><![CDATA[Lacuna continuously runs BODY, FORM, and AIR layers. Buttons remove those layers; Button 4 creates a complete VOID. Tap the encoder to record one four-beat negative rhythm and hold it to clear.]]></notes>
   <windowPos><x>100</x><y>60</y><width>1000</width><height>900</height></windowPos>
</patch-1.0>
