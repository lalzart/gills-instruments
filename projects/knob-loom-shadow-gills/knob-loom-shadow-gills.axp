<patch-1.0 appVersion="1.0.12">
   <comment type="patch/comment" x="14" y="14" text="KNOB LOOM SHADOW - eight motion threads plus a two-wave negative-rhythm shuttle"/>
   <comment type="patch/comment" x="14" y="42" text="Pots 1-8 tune and excite | Pot 9 tension | Pot 10 aperture"/>
   <comment type="patch/comment" x="14" y="70" text="Buttons: strum/reset | reverse | sustain | tangle | Encoder decay | push scale"/>

   <obj type="audio/outconfig" uuid="eace67e3304afaa1bb695b444e9345f2d8adaf00" name="output_config" x="14" y="112">
      <params/>
      <attribs>
         <combo attributeName="headphones" selection="-24dB"/>
         <combo attributeName="mode" selection="Stereo"/>
      </attribs>
   </obj>

   <obj type="const/i" uuid="e202f44b2df17ae0b3e663b98ea6b14c8ff00408" name="decay_init" x="154" y="112">
      <params/><attribs><spinner attributeName="value" value="72"/></attribs>
   </obj>

   <obj type="ksoloti/gills/encoder" uuid="8d8c7129-cce1-491f-98b4-6ecb6355cfee" name="decay" x="266" y="98">
      <params/>
      <attribs>
         <spinner attributeName="min" value="0"/>
         <spinner attributeName="max" value="127"/>
      </attribs>
   </obj>

   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="thread1" x="14" y="224"><params/><attribs><combo attributeName="pot" selection="1"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="thread2" x="14" y="280"><params/><attribs><combo attributeName="pot" selection="2"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="thread3" x="14" y="336"><params/><attribs><combo attributeName="pot" selection="3"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="thread4" x="14" y="392"><params/><attribs><combo attributeName="pot" selection="4"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="thread5" x="14" y="448"><params/><attribs><combo attributeName="pot" selection="5"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="thread6" x="14" y="504"><params/><attribs><combo attributeName="pot" selection="6"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="thread7" x="14" y="560"><params/><attribs><combo attributeName="pot" selection="7"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="thread8" x="14" y="616"><params/><attribs><combo attributeName="pot" selection="8"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="tension" x="14" y="672"><params/><attribs><combo attributeName="pot" selection="9"/></attribs></obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="aperture" x="14" y="728"><params/><attribs><combo attributeName="pot" selection="10"/></attribs></obj>

   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="strum" x="182" y="224"><params/><attribs><combo attributeName="button" selection="1"/></attribs></obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="reverse" x="182" y="294"><params/><attribs><combo attributeName="button" selection="2"/></attribs></obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="sustain" x="182" y="364"><params/><attribs><combo attributeName="button" selection="3"/></attribs></obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="tangle" x="182" y="434"><params/><attribs><combo attributeName="button" selection="4"/></attribs></obj>

   <obj type="./knobloom_shadow" uuid="62D4FBD7-4E2A-4E8A-9CA9-9176081B1B3F" name="knobloom_shadow" x="406" y="252"><params/><attribs/></obj>
   <obj type="audio/out stereo" uuid="a1ca7a567f535acc21055669829101d3ee7f0189" name="audio_out" x="770" y="266"><params/><attribs/></obj>

   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led1" x="770" y="378"><params/><attribs><combo attributeName="led" selection="1"/></attribs></obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led2" x="770" y="434"><params/><attribs><combo attributeName="led" selection="2"/></attribs></obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led3" x="770" y="490"><params/><attribs><combo attributeName="led" selection="3 blue"/></attribs></obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led4" x="770" y="546"><params/><attribs><combo attributeName="led" selection="4 blue"/></attribs></obj>

   <obj type="ksoloti/gills/display" uuid="0c083e83-0280-4cf2-b747-8a00859bb904" name="display" x="770" y="644">
      <params/><attribs><combo attributeName="useScope" selection="off"/><objref attributeName="scope" obj=""/><combo attributeName="narrowFont" selection="on"/></attribs>
   </obj>

   <nets>
      <net><source obj="decay_init" outlet="out"/><dest obj="decay" inlet="set"/></net>
      <net><source obj="decay" outlet="out"/><dest obj="knobloom_shadow" inlet="decay"/></net>
      <net><source obj="decay" outlet="sw"/><dest obj="knobloom_shadow" inlet="scale"/></net>
      <net><source obj="thread1" outlet="out"/><dest obj="knobloom_shadow" inlet="thread1"/></net>
      <net><source obj="thread2" outlet="out"/><dest obj="knobloom_shadow" inlet="thread2"/></net>
      <net><source obj="thread3" outlet="out"/><dest obj="knobloom_shadow" inlet="thread3"/></net>
      <net><source obj="thread4" outlet="out"/><dest obj="knobloom_shadow" inlet="thread4"/></net>
      <net><source obj="thread5" outlet="out"/><dest obj="knobloom_shadow" inlet="thread5"/></net>
      <net><source obj="thread6" outlet="out"/><dest obj="knobloom_shadow" inlet="thread6"/></net>
      <net><source obj="thread7" outlet="out"/><dest obj="knobloom_shadow" inlet="thread7"/></net>
      <net><source obj="thread8" outlet="out"/><dest obj="knobloom_shadow" inlet="thread8"/></net>
      <net><source obj="tension" outlet="out"/><dest obj="knobloom_shadow" inlet="tension"/></net>
      <net><source obj="aperture" outlet="out"/><dest obj="knobloom_shadow" inlet="aperture"/></net>
      <net><source obj="strum" outlet="out"/><dest obj="knobloom_shadow" inlet="strum"/></net>
      <net><source obj="reverse" outlet="out"/><dest obj="knobloom_shadow" inlet="reverse"/></net>
      <net><source obj="sustain" outlet="out"/><dest obj="knobloom_shadow" inlet="sustain"/></net>
      <net><source obj="tangle" outlet="out"/><dest obj="knobloom_shadow" inlet="tangle"/></net>
      <net><source obj="knobloom_shadow" outlet="left"/><dest obj="audio_out" inlet="left"/></net>
      <net><source obj="knobloom_shadow" outlet="right"/><dest obj="audio_out" inlet="right"/></net>
      <net><source obj="knobloom_shadow" outlet="led1"/><dest obj="led1" inlet="in"/></net>
      <net><source obj="knobloom_shadow" outlet="led2"/><dest obj="led2" inlet="in"/></net>
      <net><source obj="knobloom_shadow" outlet="led3"/><dest obj="led3" inlet="in"/></net>
      <net><source obj="knobloom_shadow" outlet="led4"/><dest obj="led4" inlet="in"/></net>
      <net><source obj="knobloom_shadow" outlet="line1"/><dest obj="display" inlet="line1"/></net>
      <net><source obj="knobloom_shadow" outlet="line2"/><dest obj="display" inlet="line2"/></net>
      <net><source obj="knobloom_shadow" outlet="line3"/><dest obj="display" inlet="line3"/></net>
      <net><source obj="knobloom_shadow" outlet="line4"/><dest obj="display" inlet="line4"/></net>
   </nets>

   <settings>
      <subpatchmode>no</subpatchmode><MidiChannel>1</MidiChannel><NPresets>0</NPresets><NPresetEntries>0</NPresetEntries><NModulationSources>0</NModulationSources><NModulationTargetsPerSource>0</NModulationTargetsPerSource><Author>Lance Ship</Author>
   </settings>
   <notes><![CDATA[Knob Loom Shadow is silent until a thread pot moves or Button 1 strums. Pots 1-8 retain the original motion-excited modal threads. Tension moves two slow waves apart; Aperture decides how broad and deep their negative-rhythm intersections become. Shadow events cut rounded holes and release short papery ticks from existing thread energy.]]></notes>
   <windowPos><x>100</x><y>60</y><width>1000</width><height>900</height></windowPos>
</patch-1.0>
