<patch-1.0 appVersion="1.0.12">
   <comment type="patch/comment" x="14" y="14" text="TIDEPOOL - four-stage organic generative granular instrument for Ksoloti Gills"/>
   <comment type="patch/comment" x="14" y="42" text="Pots 1-4 wave heights | 5 rate | 6 memory | 7 timbre | 8 grain position | 9 grain size | 10 texture"/>
   <comment type="patch/comment" x="14" y="70" text="Buttons: 1 oscillator | 2 mutate | 3 evolution lock | 4 capture | Encoder root | tap scale | hold wave destination"/>

   <obj type="audio/outconfig" uuid="eace67e3304afaa1bb695b444e9345f2d8adaf00" name="audio_config" x="14" y="112">
      <params/>
      <attribs>
         <combo attributeName="headphones" selection="-24dB"/>
         <combo attributeName="mode" selection="Stereo"/>
      </attribs>
   </obj>

   <obj type="const/i" uuid="e202f44b2df17ae0b3e663b98ea6b14c8ff00408" name="root_init" x="14" y="168">
      <params/>
      <attribs><spinner attributeName="value" value="60"/></attribs>
   </obj>

   <obj type="ksoloti/gills/encoder" uuid="8d8c7129-cce1-491f-98b4-6ecb6355cfee" name="root" x="126" y="154">
      <params/>
      <attribs>
         <spinner attributeName="min" value="36"/>
         <spinner attributeName="max" value="72"/>
      </attribs>
   </obj>

   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="stage1" x="14" y="252">
      <params/><attribs><combo attributeName="pot" selection="1"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="stage2" x="14" y="308">
      <params/><attribs><combo attributeName="pot" selection="2"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="stage3" x="14" y="364">
      <params/><attribs><combo attributeName="pot" selection="3"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="stage4" x="14" y="420">
      <params/><attribs><combo attributeName="pot" selection="4"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="rate" x="14" y="476">
      <params/><attribs><combo attributeName="pot" selection="5"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="memory" x="14" y="532">
      <params/><attribs><combo attributeName="pot" selection="6"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="timbre" x="14" y="588">
      <params/><attribs><combo attributeName="pot" selection="7"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="grain_position" x="14" y="644">
      <params/><attribs><combo attributeName="pot" selection="8"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="grain_size" x="14" y="700">
      <params/><attribs><combo attributeName="pot" selection="9"/></attribs>
   </obj>
   <obj type="ksoloti/gills/pot p" uuid="1c0c845ed2d7e06ae5f377ba13d9d09f4747ac89" name="texture" x="14" y="756">
      <params/><attribs><combo attributeName="pot" selection="10"/></attribs>
   </obj>

   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="oscillator" x="182" y="252">
      <params/><attribs><combo attributeName="button" selection="1"/></attribs>
   </obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="mutate" x="182" y="322">
      <params/><attribs><combo attributeName="button" selection="2"/></attribs>
   </obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="lock" x="182" y="392">
      <params/><attribs><combo attributeName="button" selection="3"/></attribs>
   </obj>
   <obj type="ksoloti/gills/button" uuid="07be7a50-1051-436a-92aa-03e2fb9b1229" name="freeze" x="182" y="462">
      <params/><attribs><combo attributeName="button" selection="4"/></attribs>
   </obj>

   <obj type="./tidepool" uuid="000D9678-7CD6-4713-AB81-70340450EBFA" name="tidepool" x="392" y="238">
      <params/>
      <attribs/>
   </obj>

   <obj type="audio/out stereo" uuid="a1ca7a567f535acc21055669829101d3ee7f0189" name="audio_out" x="756" y="252">
      <params/><attribs/>
   </obj>

   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led1" x="756" y="364">
      <params/><attribs><combo attributeName="led" selection="1"/></attribs>
   </obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led2" x="756" y="420">
      <params/><attribs><combo attributeName="led" selection="2"/></attribs>
   </obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led3" x="756" y="476">
      <params/><attribs><combo attributeName="led" selection="3 blue"/></attribs>
   </obj>
   <obj type="ksoloti/gills/led" uuid="d4980ecb-5e48-42a3-bdcf-2ddfb1f5c712" name="led4" x="756" y="532">
      <params/><attribs><combo attributeName="led" selection="4 blue"/></attribs>
   </obj>

   <obj type="ksoloti/gills/display" uuid="0c083e83-0280-4cf2-b747-8a00859bb904" name="display" x="756" y="630">
      <params/>
      <attribs>
         <combo attributeName="useScope" selection="off"/>
         <objref attributeName="scope" obj=""/>
         <combo attributeName="narrowFont" selection="on"/>
      </attribs>
   </obj>

   <nets>
      <net><source obj="root_init" outlet="out"/><dest obj="root" inlet="set"/></net>
      <net><source obj="root" outlet="out"/><dest obj="tidepool" inlet="encoder"/></net>
      <net><source obj="root" outlet="sw"/><dest obj="tidepool" inlet="encoder_sw"/></net>

      <net><source obj="stage1" outlet="out"/><dest obj="tidepool" inlet="stage1"/></net>
      <net><source obj="stage2" outlet="out"/><dest obj="tidepool" inlet="stage2"/></net>
      <net><source obj="stage3" outlet="out"/><dest obj="tidepool" inlet="stage3"/></net>
      <net><source obj="stage4" outlet="out"/><dest obj="tidepool" inlet="stage4"/></net>
      <net><source obj="rate" outlet="out"/><dest obj="tidepool" inlet="rate"/></net>
      <net><source obj="memory" outlet="out"/><dest obj="tidepool" inlet="memory"/></net>
      <net><source obj="timbre" outlet="out"/><dest obj="tidepool" inlet="timbre"/></net>
      <net><source obj="grain_position" outlet="out"/><dest obj="tidepool" inlet="position"/></net>
      <net><source obj="grain_size" outlet="out"/><dest obj="tidepool" inlet="size"/></net>
      <net><source obj="texture" outlet="out"/><dest obj="tidepool" inlet="texture"/></net>

      <net><source obj="oscillator" outlet="out"/><dest obj="tidepool" inlet="oscillator"/></net>
      <net><source obj="mutate" outlet="out"/><dest obj="tidepool" inlet="mutate"/></net>
      <net><source obj="lock" outlet="out"/><dest obj="tidepool" inlet="lock"/></net>
      <net><source obj="freeze" outlet="out"/><dest obj="tidepool" inlet="freeze"/></net>

      <net><source obj="tidepool" outlet="left"/><dest obj="audio_out" inlet="left"/></net>
      <net><source obj="tidepool" outlet="right"/><dest obj="audio_out" inlet="right"/></net>
      <net><source obj="tidepool" outlet="led1"/><dest obj="led1" inlet="in"/></net>
      <net><source obj="tidepool" outlet="led2"/><dest obj="led2" inlet="in"/></net>
      <net><source obj="tidepool" outlet="led3"/><dest obj="led3" inlet="in"/></net>
      <net><source obj="tidepool" outlet="led4"/><dest obj="led4" inlet="in"/></net>
      <net><source obj="tidepool" outlet="line1"/><dest obj="display" inlet="line1"/></net>
      <net><source obj="tidepool" outlet="line2"/><dest obj="display" inlet="line2"/></net>
      <net><source obj="tidepool" outlet="line3"/><dest obj="display" inlet="line3"/></net>
      <net><source obj="tidepool" outlet="line4"/><dest obj="display" inlet="line4"/></net>
   </nets>

   <settings>
      <subpatchmode>no</subpatchmode>
      <MidiChannel>1</MidiChannel>
      <NPresets>0</NPresets>
      <NPresetEntries>0</NPresetEntries>
      <NModulationSources>0</NModulationSources>
      <NModulationTargetsPerSource>0</NModulationTargetsPerSource>
      <Author>Lance Ship</Author>
   </settings>
   <notes><![CDATA[Tidepool runs continuously. Button 1 cycles FLUT, RND, and FOLD. Start with pot positions approximately 2, 5, 8, 3 for a rising-and-falling wave.]]></notes>
   <windowPos><x>100</x><y>60</y><width>980</width><height>860</height></windowPos>
</patch-1.0>
